---
// One line of the numbered project index (Home and Projects pages):
// title, where, and the one-sentence summary. The full story is on the project's page.
import type { CollectionEntry } from 'astro:content';
import { hasDetailPage } from '../lib/content';

interface Props {
  entry: CollectionEntry<'projects'>;
  number: number;
  headingLevel?: 'h2' | 'h3';
}
const { entry, number, headingLevel = 'h3' } = Astro.props;
const { data } = entry;
const href = hasDetailPage(entry) ? `/projects/${entry.id}/` : undefined;
const Heading = headingLevel;
---

<article class="group grid gap-x-8 gap-y-3 border-t border-line py-7 md:grid-cols-12">
  <p class="font-mono text-sm text-brand md:col-span-1 md:pt-1" aria-hidden="true">{String(number).padStart(2, '0')}</p>
  <div class="md:col-span-11">
    <Heading class="text-xl font-semibold leading-snug sm:text-2xl">
      {href ? <a href={href} class="hover:text-brand hover:underline hover:decoration-plum underline-offset-4">{data.title}</a> : data.title}
    </Heading>
    <p class="mt-2 font-mono text-xs uppercase tracking-wide text-muted">
      {data.where}{data.where && data.artifactKind && ' · '}{data.artifactKind && <span>{data.artifactKind}</span>}
    </p>
    <p class="mt-3 max-w-[60ch] leading-relaxed text-muted">{data.summary}</p>
  </div>
</article>
