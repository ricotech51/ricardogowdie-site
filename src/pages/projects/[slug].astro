---
// A page for every published project.
// Any part still marked [PLACEHOLDER] is left off the page.
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ResultText from '../../components/ResultText.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { getProjects, getSite, hasPlaceholder } from '../../lib/content';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects
    .map((entry, i) => ({ params: { slug: entry.id }, props: { entry, number: i + 1 } }));
}

const { entry, number } = Astro.props;
const { data } = entry;
const site = await getSite();
const { Content } = await render(entry);
const showProblem = !hasPlaceholder(data.problem);
// Search description: the fuller "What I did" line, unless it is too long for a search result.
const description = data.action.length <= 170 ? data.action : data.summary;
const boxes = 1 + (showProblem ? 1 : 0) + (data.result ? 1 : 0);
const showBody = !hasPlaceholder(entry.body) && (entry.body ?? '').trim().length > 0;
---

<Base title={data.title} description={description} type="article">
  <Section number={String(number).padStart(2, '0')} label={data.tag} first headingId="pj-title">
    <a href="/projects/" class="link text-sm">All projects</a>
    <h1 id="pj-title" class="mt-4 max-w-[24ch] text-4xl font-semibold leading-[1.1] sm:text-5xl">{data.title}</h1>
    {data.where && <p class="mt-4 font-mono text-sm uppercase tracking-wide text-muted">{data.where}</p>}

    <dl class:list={['mt-10 grid gap-6', boxes === 3 && 'md:grid-cols-3', boxes === 2 && 'md:grid-cols-2']}>
      {showProblem && <div class="rounded-xl border border-line bg-surface p-5"><dt class="label">The situation</dt><dd class="mt-2">{data.problem}</dd></div>}
      <div class="rounded-xl border border-line bg-surface p-5"><dt class="label">What I did</dt><dd class="mt-2">{data.action}</dd></div>
      {data.result && <div class="rounded-xl border border-line bg-surface p-5"><dt class="label">Result</dt><dd class="mt-2"><ResultText text={data.result} class="font-semibold text-brand" /></dd></div>}
    </dl>


    {showBody && <div class="prose mt-12"><Content /></div>}

    {
      data.tech.length > 0 && (
        <ul class="mt-10 flex flex-wrap gap-x-5 gap-y-1 border-t border-line pt-5 font-mono text-xs text-muted" aria-label="Technologies">
          {data.tech.map((t) => <li>{t}</li>)}
        </ul>
      )
    }
    {
      (data.liveUrl || data.repoUrl) && (
        <p class="mt-8 flex gap-6">
          {data.liveUrl && <ExternalLink class="link" href={data.liveUrl}>Live site</ExternalLink>}
          {data.repoUrl && <ExternalLink class="link" href={data.repoUrl}>Source code</ExternalLink>}
        </p>
      )
    }
  </Section>
  <Section number="→" label="Let's talk" tone="surface" last headingId="pj-cta">
    <h2 id="pj-cta" class="max-w-[22ch] text-3xl font-semibold leading-tight sm:text-4xl">{site.closing.headline}</h2>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <ExternalLink href={site.bookingUrl} class="btn-primary">{site.closing.primaryButton}</ExternalLink>
      <a href="/projects/" class="link font-medium">All projects</a>
    </div>
  </Section>
</Base>
