---
import Base from '../../layouts/Base.astro';
import Section from '../../components/Section.astro';
import ProjectRow from '../../components/ProjectRow.astro';
import ExternalLink from '../../components/ExternalLink.astro';
import { getProjects, getSite } from '../../lib/content';

const site = await getSite();
const projects = await getProjects();
---

<Base title="IT infrastructure and networking projects" description="IT infrastructure and networking projects: failover clustering, backups, Azure, Active Directory and Entra ID, VLAN segmentation and wireless, each with a diagram.">
  <Section number="01" label="Projects" first headingId="pj-title">
    <h1 id="pj-title" class="max-w-[20ch] text-4xl font-semibold leading-[1.1] sm:text-5xl">What I planned, built, and <span class="emph">what changed</span>.</h1>
    <p class="mt-6 max-w-[60ch] text-lg text-muted">Each project has a diagram, plan or board that shows how the work was done. They are samples with made-up names and addresses, so no client or employer details are shared.</p>
    <ol class="mt-12 border-b border-line">
      {projects.map((p, i) => <li><ProjectRow entry={p} number={i + 1} headingLevel="h2" /></li>)}
    </ol>
  </Section>
  <Section number="02" label="Let's talk" tone="surface" last headingId="pj-cta">
    <h2 id="pj-cta" class="max-w-[22ch] text-3xl font-semibold leading-tight sm:text-4xl">{site.closing.headline}</h2>
    <div class="mt-8 flex flex-wrap items-center gap-x-6 gap-y-4">
      <ExternalLink href={site.bookingUrl} class="btn-primary">{site.closing.primaryButton}</ExternalLink>
      <a href={`mailto:${site.email}`} class="link font-medium">{site.closing.secondaryLink}</a>
    </div>
  </Section>
</Base>
